# blender-worker/Dockerfile.pbr
# PBR material worker — self-hosted on Azure Container Apps (GPU)
#
# Exposes the same queue protocol that server/pbr/falPbr.ts already speaks:
#   POST /queue/submit   { endpoint, input }   → { request_id }
#   GET  /queue/status    ?requestId=<id>       → { status, error? }
#   GET  /queue/result    ?requestId=<id>       → { data }
#
# Build:
#   docker build -f blender-worker/Dockerfile.pbr -t paws-pbr-worker .
#
# Run locally (CPU-only smoke test):
#   docker run -p 8080:8080 -e WORKER_SECRET=dev paws-pbr-worker

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY blender-worker/requirements-pbr.txt .
RUN pip3 install --no-cache-dir -r requirements-pbr.txt

COPY blender-worker/pbr_worker.py .

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"

CMD ["python3", "pbr_worker.py"]
