# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional comma-separated Gemini image fallback chain (first successful model wins).
GEMINI_IMAGE_MODELS="gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image"

# Phase 9 calibrated text/image building proposals and enhanced before/after
# scale verification. Keep both false until the Render IFC worker and browser
# acceptance matrix pass. The server flag is authoritative; the Vite flag only
# exposes the controls and is baked into the client at build time.
BIM_V2_ENABLED="false"
VITE_BIM_V2_ENABLED="false"
BIM_PROPOSAL_MODEL="gemini-3.1-flash-lite"

# Durable model platform dark-launch flags. Leave every flag false in the first
# production deployment. Enable one phase at a time only after its external
# worker, storage, provider, browser, and human acceptance gates pass.
MODEL_BUILD_V3_ENABLED="false"
RIG_PIPELINE_V4_ENABLED="false"
FUR_BIN_V5_ENABLED="true"
VITE_FUR_BIN_V5_ENABLED="true"

# Phase 1 free first image. Keep false until the verification loop has been
# exercised in production: enabling it hands one free Gemini generation to
# every account that confirms its email. Requires FUR_BIN_V5_ENABLED, since
# Fur Bin is the delivery surface.
FREE_FIRST_IMAGE_ENABLED="false"

# PawPrints v3 teaching UI (annotated sample prompts, idea chips, optional
# printed caption). Presentation only — no paid path changes — but keep it
# false until the copy and layout have been reviewed on a real device.
VITE_PAWPRINTS_V3_UI="false"

# Phase 3 purchase-gated PawPrints. Nothing generates until the Shopify order
# webhook confirms payment. REQUIRES at least one Shopify product carrying the
# custom.pawprint_personalizable metafield set to true — checkout fails closed
# with NO_PERSONALIZABLE_PRODUCT otherwise, by design.
PAWPRINT_PURCHASE_GATE_ENABLED="false"
# Leave unset/false to require admin review before art is released to a paying
# customer. Set true only once render quality is trusted.
PAWPRINT_AUTO_APPROVE="false"

# Phase 4 BYOK image playground. Customers generate on their OWN Google AI
# Studio key, so nothing is billed to us and nothing is metered in PupCoins.
# KEY_ENCRYPTION_SECRET is REQUIRED before enabling: it encrypts stored keys
# (AES-256-GCM) and must be at least 32 characters. Losing or rotating it makes
# every stored key undecryptable — customers would simply reconnect.
# Phase 6 Video Studio v2 teaching UI (annotated sample prompts per duration,
# idea chips, honest duration notes). Presentation only — no paid path changes.
# VITE_ flags are baked in at BUILD time locally; setting this in Hostinger has
# no effect. Set it in the local .env, rebuild, redeploy.
VITE_VIDEO_STUDIO_V2="false"

# Background removal (BiRefNet via fal.ai — MIT on code and weights). Uses the
# existing FAL_KEY. Cutouts are cached by source hash and stored in the PRIVATE
# bucket. Fails open: an outage returns the original photo, never blocks an
# order. Keep false until quality is checked against real pet photos — fur is
# the failure mode.
PHOTO_EDIT_ENABLED="false"

BYOK_PLAYGROUND_ENABLED="false"
KEY_ENCRYPTION_SECRET=""

# Phase 5 free-avatar window. The gate itself lives in the app_settings table,
# not here, because you open and close it on demand and an env change would
# need a redeploy. It defaults to CLOSED — free avatars are unavailable until
# an admin opens the window via POST /api/admin/free-avatar/gate.

# Toss-it model feedback is delivered through Resend. Falls back to ADMIN_EMAIL.
MODEL_FEEDBACK_EMAIL=""
RESEND_API_KEY=""
MAIL_FROM=""
STATIONERY_V2_ENABLED="false"
WAGS_V2_ENABLED="false"
CUSTOMIZER_CHECKOUT_ENABLED="false"

# X photo-claim funnel. A pet photo DMed to the X account is parked and answered
# with a one-time link into the studio -- it never starts a generation, so the
# account, the PupCoin reservation and the view approval all still apply.
# Unset here means the mint endpoint 404s, which is the correct default.
# Generate with: openssl rand -hex 32
X_CLAIM_SERVICE_SECRET=""
# Only needed if the claim URL should not point at https://pawsome3d.com.
PUBLIC_BASE_URL=""

# Wags v2 uses a separate Stripe endpoint and signing secret. Do not reuse
# STRIPE_WEBHOOK_SECRET. Configure only before WAGS_V2_ENABLED=true:
# https://pawsome3d.com/api/wags-v2/stripe/webhooks
WAGS_STRIPE_WEBHOOK_SECRET=""

# Stationery v2 render worker, provider callbacks, and fulfillment adapters.
# Required before enabling STATIONERY_V2_ENABLED=true.
STATIONERY_RENDER_WORKER_URL=""
STATIONERY_RENDER_WORKER_SECRET=""
STATIONERY_CALLBACK_BASE_URL="https://pawsome3d.com"
STATIONERY_WORKER_PORT="8090"
STATIONERY_WORKER_VERSION="1.0.0"
PRINTFUL_WEBHOOK_SECRET=""
SLANT3D_WEBHOOK_SECRET=""
PRINTFUL_API_KEY=""
PRINTFUL_STORE_ID=""
PRINTFUL_API_BASE_URL="https://api.printful.com"
# JSON map from Stationery providerSku to Printful numeric variant ID.
PRINTFUL_STATIONERY_VARIANT_MAP='{}'
SLANT3D_API_KEY=""
SLANT3D_PLATFORM_ID=""
SLANT3D_DEFAULT_FILAMENT_ID=""
SLANT3D_API_BASE_URL="https://slant3dapi.com/v2/api"

# APP_URL: The URL where this app is hosted (production: https://pawsome3d.com).
# Used for self-referential links and Stripe checkout success/cancel redirects.
APP_URL="https://pawsome3d.com"

# STRIPE_SECRET_KEY: Required for communicating with Stripe API.
# Obtain from your Stripe Dashboard (Developers > API keys). Starts with sk_test_ or sk_live_.
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"

# STRIPE_WEBHOOK_SECRET: Required for verifying Stripe webhook authenticity. Starts with whsec_.
# This is the signing secret for the Stripe webhook endpoint, which must point at
# https://pawsome3d.com/api/stripe-webhook and listen to checkout.session.completed +
# checkout.session.async_payment_succeeded. Editing an existing endpoint's URL keeps
# the same secret; creating a NEW endpoint issues a new secret you must paste here.
STRIPE_WEBHOOK_SECRET="MY_STRIPE_WEBHOOK_SECRET"

# --- Authentication (email + password) ---
# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET="MY_JWT_SECRET"

# Admin account — server upserts this on every boot. Admins log in through the
# normal login screen using ADMIN_EMAIL + ADMIN_PASSWORD.
# ADMIN_KEY is just an internal unique row key (any short string, e.g. "admin");
# it is NOT a phone number.
ADMIN_KEY="admin"
ADMIN_EMAIL="your@email.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- MySQL database (user store / gating) ---
# On Hostinger, use 127.0.0.1 (NOT "localhost") so mysql2 connects over IPv4 and
# matches the database user's grant. DB_PORT defaults to 3306 if omitted.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="MY_DB_NAME"
DB_USER="MY_DB_USER"
DB_PASSWORD="MY_DB_PASSWORD"

# Optional MySQL pool tuning. Defaults are safe for the Hostinger Node process;
# change only after observing /readyz and database connection metrics.
DB_CONNECTION_LIMIT="10"
DB_MAX_IDLE="10"
DB_IDLE_TIMEOUT_MS="60000"
DB_CONNECT_TIMEOUT_MS="10000"
DB_KEEPALIVE_DELAY_MS="0"
DB_QUEUE_LIMIT="0"

# Release provenance exposed at /version and /readyz. Set these while packaging.
APP_COMMIT_SHA=""
APP_BUILD_TIME=""

# --- Google Maps Platform ---
# CRITICAL: Create TWO separate API keys in Google Cloud Console.
# 1. SERVER key: used server-side for Street View metadata/images, Places text search
#    (landmarks), and the Community page's nearby parks (Places Nearby Search) + weather
#    (Weather API). Must NOT have an HTTP-referrer restriction (server calls have no
#    referrer) — leave unrestricted or restrict by your Hostinger server IP.
#    Enable these APIs on this key: Street View Static API, Places API, Weather API.
# 2. BROWSER key: Restrict by HTTP Referrer (e.g., https://pawsome3d.com/*,
#    https://www.pawsome3d.com/*, http://localhost:3000/*) and APIs: Maps JavaScript API,
#    Places API. This is a VITE_ var and is baked into the frontend at BUILD time, so it
#    must be present when `npm run build` runs. NEVER expose the SERVER key to the frontend.
GOOGLE_MAPS_API_KEY_SERVER="YOUR_SERVER_RESTRICTED_KEY"

# Frontend Vite environment variable (must be prefixed with VITE_)
VITE_GOOGLE_MAPS_API_KEY_BROWSER="YOUR_BROWSER_RESTRICTED_KEY"

# --- Community page: no keys required ---
# Pet recall news uses the free openFDA enforcement API; the live pet board uses the
# free public dog.ceo + dogapi.dog APIs; weather falls back to free open-meteo if the
# Google Weather API isn't enabled. User photo uploads reuse the MEDIA_BUCKET_* storage.

# --- Object Storage (Phase 2+) ---
# Required for storing generated videos and large still images (avoids base64/DB bloat).
# Supports Hostinger Object Storage, AWS S3, or Backblaze B2.
MEDIA_BUCKET_NAME="pawsmemories-media"
MEDIA_BUCKET_URL="https://s3.us-east-005.backblazeb2.com"
MEDIA_BUCKET_KEY="YOUR_ACCESS_KEY"
MEDIA_BUCKET_SECRET="YOUR_SECRET_KEY"

# --- Private asset bucket (required in production) ---
# Backblaze B2 does NOT support per-object ACLs: objects inherit the bucket ACL
# and setting a differing object ACL returns 403. The public MEDIA_BUCKET_NAME
# therefore cannot hold customer reference images or purchasable assets. Source
# photos, generated multiview references, paid source GLBs, and STL derivatives
# go in this separate PRIVATE bucket. Production refuses to start when this
# configuration is missing, uses placeholders, or points at the public bucket.
# Bucket created 2026-07-20 in the same B2 account, same endpoint.
MEDIA_PRIVATE_BUCKET_NAME="pawsmemories-private"
# Seconds a presigned download URL stays valid. Default 900 (15 min).
MEDIA_SIGNED_URL_TTL_SECONDS="900"
# Leave BOTH blank to reuse MEDIA_BUCKET_KEY/_SECRET. If either private value is
# set, both are required. The selected key must be able to write/read the private
# bucket and create presigned downloads; a public-bucket-only key will fail.
# Bound a stalled B2 call so the SDK retry policy can act on it. A connection
# that hangs without erroring never produces a result to retry.
# MEDIA_BUCKET_CONNECT_TIMEOUT_MS defaults 6000, MEDIA_BUCKET_REQUEST_TIMEOUT_MS
# defaults 60000 (socket inactivity, not total duration, so large uploads are
# unaffected), MEDIA_BUCKET_MAX_ATTEMPTS defaults 4.
MEDIA_BUCKET_CONNECT_TIMEOUT_MS=""
MEDIA_BUCKET_REQUEST_TIMEOUT_MS=""
MEDIA_BUCKET_MAX_ATTEMPTS=""
MEDIA_PRIVATE_BUCKET_KEY=""
MEDIA_PRIVATE_BUCKET_SECRET=""

# --- 3D Generation ---
# The model generator runs on Tripo. It is the only provider the factory can
# construct; any other value fails closed with UNSUPPORTED_PROVIDER.
# Verify a configuration before setting it in Hostinger:
#   npx tsx scripts/manual/model-generator-doctor.ts
# PAWS_3D_PROVIDER was removed on 2026-08-21. Tripo is bound in code, so there
# is no provider to select and no way to misconfigure one.
# Gate for the paid pet GLB builder; the factory refuses to construct a
# provider unless this is exactly "true".
PET_GLB_ENABLED="false"
PAWS_REFERENCE_DOWNLOAD_HOSTS=""
BLENDER_VERSION="5.1.2"
# Full Paws repository commit used to build both accepted runtime images.
# Leave blank until that rebuild, private readback, and acceptance are complete.
BLENDER_WORKER_REVISION=""

# Required by the model generator. Paid Tripo stages cannot dispatch without it.
TRIPO_API_KEY=""

# --- Blender Worker Microservice ---
# Internal URL of the private Blender worker. This must not point at Render or
# another externally managed generation service.
# WORKER_SHARED_SECRET must be IDENTICAL here and in the private worker's env
# (sent as the x-worker-secret header). A mismatch = every worker call 401s.
BLENDER_WORKER_URL=""
WORKER_SHARED_SECRET=""
# Optional durable BIM worker timeout (1,000-600,000 ms; default 180,000).
BIM_WORKER_TIMEOUT_MS="180000"

# --- AR Virtual Pet Simulator (AR_PET_SIM_SPEC) ---
# Feature flag for the Tripo auto-rig pipeline (POST /api/pets/:id/rig). Off by
# default so avatars without a rig keep the current render path.
PETSIM_RIG_ENABLED="false"
# Optional: pin the Tripo rig model version (defaults to v2.0-20250506 in code).
# MG-4: fail-closed. The paid (35 PupCoin) body-rig add-on stays disabled unless
# this is explicitly "true", matching MODEL_BUILD_V3_ENABLED / RIG_PIPELINE_V4_ENABLED.
# Do not enable until a real live rig run has been verified end to end.
PET_GLB_BODY_RIG_ENABLED="false"
TRIPO_RIG_MODEL_VERSION="v2.5-20260210"

# Paid-endpoint hardening (H2/H7) for classify, rig, semantic-scan, and each
# actual shared Gemini/Imagen image-provider call.
# Kill-switches — return 503 when off. Omit/leave blank to use defaults.
#   Master switch for all four paid endpoints, including shared image output
#   (default: on).
PETSIM_PAID_APIS_ENABLED="true"
#   Per-endpoint switches (classify + semantic-scan + image generation default
#   on; rig uses PETSIM_RIG_ENABLED above, default off).
PETSIM_CLASSIFY_ENABLED="true"
PETSIM_SEMANTIC_SCAN_ENABLED="true"
PETSIM_IMAGE_GENERATION_ENABLED="true"
# Per-user, per-day caps — requests past the cap return 429. Defaults in code:
# classify 25, rig 5, semantic-scan 50, image-provider calls 5. Set to 0 to
# hard-disable via the cap.
PETSIM_CLASSIFY_DAILY_CAP="25"
PETSIM_RIG_DAILY_CAP="5"
PETSIM_SEMANTIC_SCAN_DAILY_CAP="50"
PETSIM_IMAGE_GENERATION_DAILY_CAP="5"
# Aggregate daily request caps across every user. Rig stays closed at zero until
# its later acceptance gates and explicit launch approval are complete.
PETSIM_CLASSIFY_GLOBAL_DAILY_CAP="250"
PETSIM_RIG_GLOBAL_DAILY_CAP="0"
PETSIM_SEMANTIC_SCAN_GLOBAL_DAILY_CAP="500"
PETSIM_IMAGE_GENERATION_GLOBAL_DAILY_CAP="50"
# Durable actual shared-image provider calls per database-backed 60-second
# window. This leaves headroom below a 20 RPM Nano Banana Pro quota. The
# dedicated Tripo reference-view path has a separate counter; these are
# intentionally not presented as one atomic combined limit.
PETSIM_IMAGE_GENERATION_GLOBAL_MINUTE_CALL_CAP="10"
# Reserve an upper-bound estimated provider cost before each call, in micro-USD
# (1 USD = 1,000,000 micro-USD), and stop at the aggregate daily ceiling.
# Review these values against current provider pricing before staging/production.
PETSIM_CLASSIFY_ESTIMATED_COST_MICRO_USD="10000"
PETSIM_RIG_ESTIMATED_COST_MICRO_USD="1000000"
PETSIM_SEMANTIC_SCAN_ESTIMATED_COST_MICRO_USD="10000"
PETSIM_IMAGE_GENERATION_ESTIMATED_COST_MICRO_USD="1000000"
PETSIM_CLASSIFY_GLOBAL_DAILY_COST_MICRO_USD="2500000"
PETSIM_RIG_GLOBAL_DAILY_COST_MICRO_USD="0"
PETSIM_SEMANTIC_SCAN_GLOBAL_DAILY_COST_MICRO_USD="5000000"
PETSIM_IMAGE_GENERATION_GLOBAL_DAILY_COST_MICRO_USD="50000000"
# Every actual shared provider attempt reserves daily, minute, and cost capacity
# in one database transaction. Upload-only, reject, validation, and disabled
# legacy requests consume nothing. Admin traffic does not bypass these limits.

# --- Multi-Agent Avatar Builder ---
# The new multi-agent pipeline uses Gemini (Vision), Claude (Reasoning), and GPT (Code Gen)
GEMINI_API_KEY="MY_GEMINI_API_KEY" # (Duplicate of above, or use the same one)

# --- fal.ai (video generation + PBR material authoring; never exposed to the browser) ---
# FAL_KEY is shared by two features:
#  - Fur Reels video generation (customer runtime): 8s Veo 3.1 Fast clips,
#    15s Kling 3.0 Pro clips (server/ai-video/falVideo.ts).
#  - PBR material authoring (offline/admin only): generated maps are validated,
#    copied into public/wardrobe/materials, reviewed, committed, and then
#    served locally. A paid run also requires the explicit authoring switch
#    below; this half is not a customer runtime dependency.
FAL_KEY=""
FAL_PBR_AUTHORING_ENABLED="0"
FAL_PBR_MAX_MATERIALS_PER_RUN="15"

# --- Azure PBR Worker (alternative to fal.ai; self-hosted on founder credits) ---
# Set these to use the Azure Container Apps PBR worker instead of fal.ai.
# When AZURE_PBR_WORKER_URL is set, FAL_KEY is not required.
AZURE_PBR_WORKER_URL=""
AZURE_PBR_WORKER_SECRET=""

# --- HeyGen API (Talking Pets) ---
HEYGEN_API_KEY="YOUR_HEYGEN_API_KEY"
HEYGEN_DEFAULT_VOICE_ID="YOUR_HEYGEN_DEFAULT_VOICE_ID"

# --- SMS Notifications (Telnyx v2; replaces Twilio/Vonage) ---
# Texts users when a memory/video is ready. Blank SMS_PROVIDER = SMS skipped.
SMS_PROVIDER="telnyx"
SMS_FROM="+12154840960"            # Telnyx local long code (E.164)
TELNYX_API_KEY=""                  # Telnyx Portal → API Keys (KEY...)
TELNYX_MESSAGING_PROFILE_ID=""     # Telnyx Portal → Messaging → your profile; assign +12154840960 to it
# Alternate providers (unused; kept for portability):
# PLIVO_AUTH_ID=""  PLIVO_AUTH_TOKEN=""
# AWS SNS reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# =====================================================================
#  Runtime / server (mostly optional — sane defaults in code)
# =====================================================================
# Port the Node server listens on. Defaults to 3000. Hostinger usually sets this
# for you via its Node app manager — only set if you need a specific port.
PORT="3000"
# Set to "production" in prod. The server also auto-detects prod when dist/index.html
# exists, so this is belt-and-suspenders.
NODE_ENV="production"
# Optional CORS allow-list (comma-separated origins). If unset, same-origin only.
# e.g. "https://pawsome3d.com,https://www.pawsome3d.com"
ALLOWED_ORIGINS=""
# Optional alternative to the DB_* vars: a single MySQL connection string.
# If DB_HOST/DB_NAME/DB_USER are set (above), you do NOT need this.
DATABASE_URL=""

# =====================================================================
#  Gemini model overrides (optional)
# =====================================================================
# Comma-separated image-model fallback chain. Defaults in code:
#   gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image
# Nano Banana Pro → Nano Banana 2 → Nano Banana 2 Lite.
# Gemini 2.x image names are filtered out by the production boundary.
GEMINI_IMAGE_MODELS=""

# Per-tier chains for Fido's Styles quality tiers (spec §6.5). Each falls back to
# GEMINI_IMAGE_MODELS behaviour when unset. Defaults in code:
#   DRAFT    = gemini-3.1-flash-lite-image,gemini-3.1-flash-image
#   STANDARD = gemini-3.1-flash-image
#   STUDIO   = gemini-3-pro-image,gemini-3.1-flash-image
GEMINI_IMAGE_MODELS_DRAFT=""
GEMINI_IMAGE_MODELS_STANDARD=""
GEMINI_IMAGE_MODELS_STUDIO=""

# Text-model chain used by palette extraction and the create-creation fallback.
# These are now READ BY THE CODE (previously GEMINI_TEXT_FALLBACK_MODEL was
# declared here but referenced nowhere). Defaults preserve prior behaviour:
#   GEMINI_TEXT_MODEL          = gemini-3.1-flash-lite
#   GEMINI_TEXT_FALLBACK_MODEL = gemini-3.1-flash-lite
# Gemini 2.x text models are retired; use the Gemini 3.1 Flash-Lite default.
GEMINI_TEXT_MODEL=""
GEMINI_TEXT_FALLBACK_MODEL=""

# Gemini adapter for Hermes job types (translate / knowledge / looks). Active
# whenever HERMES_ENABLED=false — no Gemma, no VPS worker needed. Uses the same
# GEMINI_API_KEY as everything else. Default: gemini-3.1-flash-lite.
# NOTE: the per-tier looks planning models (draft/standard→2.5-flash,
# studio→2.5-pro) are code constants in server/hermes/gemini_adapter.ts
# (HERMES_PLAN_MODEL_BY_TIER) — they are NOT env vars.
GEMINI_HERMES_MODEL="gemini-3.1-flash-lite"

# Wardrobe Wags monthly box planner model. Default: gemini-3.1-flash-lite.
GEMINI_WAGS_MODEL="gemini-3.1-flash-lite"

# =====================================================================
#  Animator / Scenes worker (optional — defaults in code)
# =====================================================================
# Where animator working files live. Defaults to ./data/animator.
ANIMATOR_DATA_DIR=""
# Set to "false" to disable the background animator job worker. Default: enabled.
ANIMATOR_WORKER_ENABLED="true"
# Worker tuning (optional): parallelism and how long before a job is stale.
ANIMATOR_WORKER_CONCURRENCY=""
ANIMATOR_STALE_MS=""
# Video jobs are failed and refunded after this many milliseconds if the
# provider never returns a result. Default: 20 minutes.
VIDEO_JOB_STALE_MS="1200000"
# Absolute path to the Rhubarb Lip-Sync CLI (Tier B). If unset, the server
# probes bin/rhubarb-lipsync, bin/rhubarb, vendor/rhubarb/*, then PATH.
# Rhubarb is OPTIONAL: when absent, lip-sync degrades Tier B → Tier A.
RHUBARB_BIN=""

# =====================================================================
#  OpenAI-compatible LLM for the multi-agent Blender pipeline (optional)
# =====================================================================
# Only needed if the multi-agent code-gen pipeline uses an OpenAI-compatible
# endpoint (e.g. OpenRouter). Leave blank to rely on Gemini/Ollama paths.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_HTTP_REFERER=""
OPENAI_X_TITLE=""

# --- Studio AI media pipeline ---
# This separate Python/Temporal pipeline is disabled by default. Enable it only
# after deploying the worker and setting the same random 32+ character secret
# on both the Node process and Studio worker. The normal Animator does not need
# this proxy.
STUDIO_PROXY_ENABLED="false"
STUDIO_SERVICE_URL=""
STUDIO_INTERNAL_SECRET=""
STUDIO_TTS_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_DEFAULT_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Note: ADMIN_PHONE is an accepted alias for ADMIN_KEY (either works as the
# internal admin row key). VITE_* vars are baked in at BUILD time, so they must
# be present when `npm run build` runs — not just at server start.

# Canonical asset registry API. Leave false until the current phase's release
# gates pass in the deployment environment. This is server-only.
CANONICAL_ASSETS_ENABLED="false"

# =====================================================================
#  Phase 9 — model cap & domain mode (per-site)
# =====================================================================
# Max models a non-admin user may keep (hard cap on pawsome3d.com). Default 5.
MODEL_CAP="5"
# Which experience this deployment serves. Set per Hostinger site:
#   main       → pawsome3d.com (full app + 5-model cap)  [default]
#   warehouse  → mypets.cc ("cold storage" viewer/manager — future phase)
DEPLOY_TARGET="main"
# Where 3D-print request emails are addressed (the "Avatars-R-Us" print form).
# Falls back to ADMIN_EMAIL if unset. Shown to logged-in users' mail client only.
PRINT_REQUEST_EMAIL=""

# =====================================================================
#  PawPrints / Shopify public catalog
# =====================================================================
# Shopify powers the read-only public /store catalog. PawPrint creation remains
# digital-only and never creates a Shopify cart or product.
# SHOPIFY_STORE_DOMAIN: the catalog store's *.myshopify.com domain (not a custom domain).
SHOPIFY_STORE_DOMAIN=""
# SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET: the matched credential pair for
# the CATALOG app installed on SHOPIFY_STORE_DOMAIN, with at least read_products
# scope. These are the Hostinger runtime catalog credentials; do not mix them
# with the separate read-only app in tools/shopify-app used by external catalog
# and SEO routines. These are exchanged server-side for a 24h Admin API access
# token (server/shopify.ts) — no static access token is stored, and the app
# refreshes it automatically.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2026-07"
# Long random Bearer token used only by the scheduled catalog snapshot job at
# POST /api/admin/shopify/catalog-sync. Admin JWTs can also trigger a manual
# sync; neither credential is exposed to the browser.
SHOPIFY_CATALOG_SYNC_SECRET=""
# SHOPIFY_WEBHOOK_SECRET: the signing secret shown when you register the
# orders/paid and orders/cancelled webhooks in Shopify Admin → Settings →
# Notifications → Webhooks, pointed at POST /api/webhooks/shopify-orders.
# Verifies the X-Shopify-Hmac-Sha256 header (server/shopify.ts). Without it
# the route rejects every delivery with 401 rather than trusting an
# unsigned request.
SHOPIFY_WEBHOOK_SECRET=""
# Set the explicit boolean product metafield custom.pawprint_personalizable in
# Shopify for products that accept a PawPrint file. Product titles and options
# are deliberately not used as personalization heuristics.

# RUNTIME_LOG_API_KEY: shared secret for GET /api/admin/runtime-log — lets the
# "Pawsome3D Runtime Log Watch" scheduled routine read logs/runtime-*.log over
# plain HTTPS (its cloud environment has no Hostinger file-browsing access).
# Generate a long random string; without it the route always 404s.
RUNTIME_LOG_API_KEY=""

# Slant 3D is the recommended managed-farm option for consistent PLA/PETG
# standard figurines and is the only 3D print provider used by the app.
# The integration is enabled only when all three values are present.
SLANT3D_API_KEY=""
SLANT3D_PLATFORM_ID=""
SLANT3D_DEFAULT_FILAMENT_ID=""
SLANT3D_API_BASE_URL="https://slant3dapi.com/v2/api"

# =====================================================================
#  Hermes edge relay (optional; disabled by default)
# =====================================================================
# Enable only after the producer bridge and MySQL migration are ready.
HERMES_ENABLED="false"
# Production must use HTTPS. HTTP loopback URLs are accepted only under NODE_ENV=test.
# Live relay (Hostinger VPS srv1830764, docker project "hermes-producer-relay"):
#   https://hermes.pawsome3d.com
# Verified 2026-07-20: GET /health returns
#   {"status":"ok","database":"ok","service":"hermes-producer-relay","version":"1.0.0"}
# The client appends /v1/jobs — do not include a path, query, or fragment here.
HERMES_EDGE_BRIDGE_URL="https://hermes-edge.example.com"
# Server-only bearer credential used for producer relay calls. Never expose to Vite.
HERMES_EDGE_PRODUCER_SECRET=""
# Upstream request timeout in milliseconds (100-60000; default 10000).
HERMES_TIMEOUT_MS="10000"
